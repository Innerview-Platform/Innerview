# Public HTTPS entry point for production (docker-compose.prod.yml).
#
#   https://{$PUBLIC_HOST}        → frontend nginx (SPA, /api, /ws-signal, /canvas, /collab, OAuth)
#   https://{$PUBLIC_HOST}:7443   → LiveKit signaling (the browser connects with wss://)
#
# PUBLIC_HOST may be a bare public IP (e.g. 187.124.30.226) or a domain. Let's Encrypt only issues
# IP-address certificates under its 6-day "shortlived" profile; Caddy renews them automatically.
# Ports 80 and 443 must be reachable from the internet for the ACME challenges.
{
	# Browsers send no SNI when they connect to a bare IP, so tell Caddy which certificate to serve.
	default_sni {$PUBLIC_HOST}
}

(letsencrypt) {
	tls {
		issuer acme {
			profile shortlived
		}
	}
}

{$PUBLIC_HOST} {
	import letsencrypt
	reverse_proxy frontend:80
}

{$PUBLIC_HOST}:7443 {
	import letsencrypt
	reverse_proxy livekit:7880
}
