{
  "name": "innerview-collaboration-editor",
  "private": true,
  "version": "0.1.0",
  "description": "Hocuspocus (Yjs) server for the interview room's shared code editor and notes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "better-sqlite3": "12.11.1",
    "jose": "6.2.12",
    "tsx": "4.23.15",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
