{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "innerview-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "innerview-backend",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "backend"
      ],
      "port": 8080
    },
    {
      "name": "innerview-canvas",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "canvas"
      ],
      "port": 5858
    },
    {
      "name": "innerview-editor",
      "runtimeExecutable": "make",
      "runtimeArgs": [
        "editor"
      ],
      "port": 1234
    },
    {
      "name": "innerview-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3100,
      "env": {
        "PORT": "3100",
        "VITE_DEV_PROXY_TARGET": "http://localhost:8081",
        "VITE_LIVEKIT_URL": "ws://localhost:7880"
      }
    }
  ]
}