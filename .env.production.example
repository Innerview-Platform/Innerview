# ═══════════════════════════════════════════════
# InnerView — production .env (single VPS)
# ═══════════════════════════════════════════════
# On the server:   cp .env.production.example .env   then fill in every CHANGE_ME.
# Generate secrets: openssl rand -hex 32
# See docs/DEPLOYMENT.md.

# Load the production overrides automatically, so plain `docker compose up -d --build` works.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ── Public address ────────────────────────────
# The app is served at https://PUBLIC_HOST (API at https://PUBLIC_HOST/api).
# A bare IP works: Caddy gets a Let's Encrypt IP certificate. A domain works too.
PUBLIC_HOST=187.124.30.226
# The VPS public IPv4 address, advertised to browsers for video/audio (WebRTC).
PUBLIC_IP=187.124.30.226

# ── Database (MySQL container; the `innerview` database is created on first start) ──
DB_USERNAME=innerview
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── JWT (shared by the backend, whiteboard and editor servers) ──
JWT_SECRET=CHANGE_ME

# ── LiveKit (video/audio). The secret must be at least 32 characters. ──
LIVEKIT_API_KEY=innerview
LIVEKIT_API_SECRET=CHANGE_ME

# ── tldraw whiteboard license (needed on production HTTPS sites) ──
# https://tldraw.dev/pricing (free trial / hobby licenses available)
VITE_TLDRAW_LICENSE_KEY=

# ── Google OAuth2 (optional) ──────────────────
# Google does not accept a bare IP as a redirect URI, so Google sign-in needs a domain.
# Email/password registration works without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_CLIENT_ID=
GOOGLE_API_CLIENT_SECRET=

# ── Email / SMTP (optional, Gmail app password; used for invitations and password reset) ──
MAIL_USERNAME=
MAIL_PASSWORD=
