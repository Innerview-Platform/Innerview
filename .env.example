# ═══════════════════════════════════════════════
# InnerView — Docker Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Variables with defaults will work out of the box for local development.
# Variables left blank are optional or require your own credentials.
#
# This file is for local development. For a server deployment use .env.production.example
# (see docs/DEPLOYMENT.md).

# ── Frontend ──────────────────────────────────
# The port where the frontend is accessible in the browser.
FRONTEND_PORT=3000

# ── Backend ───────────────────────────────────
# The URL the backend uses for CORS origins and OAuth2 redirects.
# Must match the browser-facing URL of the frontend.
FRONTEND_URL=http://localhost:3000

# ── Database (MySQL) ─────────────────────────
DB_USERNAME=innerview
DB_PASSWORD=innerview_pass
DB_ROOT_PASSWORD=root_pass
# Expose MySQL on this host port (for local clients like DBeaver/DataGrip).
DB_PORT=3306

# ── Redis ─────────────────────────────────────
# Expose Redis on this host port.
REDIS_PORT=6379

# ── Piston (code execution for the shared editor's Run button) ──
# Expose Piston on this host port. When running the backend outside Docker, also set
# PISTON_URL=http://localhost:2000 (inside Docker the backend uses http://piston:2000).
PISTON_PORT=2000

# ── DynamoDB Local (in-app notifications) ─────
DYNAMODB_PORT=8000

# ── Shared whiteboard (self-hosted Excalidraw sync server) ──
# Port of services/nodejs/collaboration-canvas. It verifies users with JWT_SECRET below.
CANVAS_PORT=5858
# Vite dev server only: where it proxies /canvas to.
VITE_DEV_CANVAS_TARGET=http://localhost:5858

# ── Shared code editor + notes (self-hosted Hocuspocus) ──
EDITOR_PORT=1234
VITE_DEV_EDITOR_TARGET=http://localhost:1234
# Internal URLs the backend calls (Docker sets these to the service names).
EDITOR_URL=http://localhost:1234
CANVAS_URL=http://localhost:5858
BACKEND_INTERNAL_URL=http://localhost:8080

# ── LiveKit keys (the dev server uses devkey/secret) ──
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── JWT ───────────────────────────────────────
# Secret used to sign JWT access and refresh tokens.
# CHANGE THIS in production!
JWT_SECRET=super-secret-jwt-key-for-dev-only-change-in-production

# ── Google OAuth2 (optional) ──────────────────
# Get these from https://console.cloud.google.com/apis/credentials
# Add http://localhost:8080/login/oauth2/code/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client used for Google Calendar events (can be the same OAuth client as above).
GOOGLE_API_CLIENT_ID=
GOOGLE_API_CLIENT_SECRET=

# ── Email / SMTP (optional) ──────────────────
# Gmail app password for sending emails (e.g., interview invitations).
MAIL_USERNAME=
MAIL_PASSWORD=

# ── LiveKit (Video / Audio streaming) ─────────
# WebSocket URL for LiveKit SFU.
VITE_LIVEKIT_URL=ws://localhost:7880
